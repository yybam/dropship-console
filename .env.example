PORT=3000

# ── Cloud Database (Turso — free at turso.tech) ───────────────────────────────
# Leave blank for local SQLite (default). Set both for cloud deployment.
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# ── Email alerts (free at resend.com) ────────────────────────────────────────
RESEND_API_KEY=re_your_key_here
ALERT_EMAIL=yybambi23@gmail.com

# Scraping — residential proxy makes Amazon/Target much more reliable
# Format: host:port:username:password
BRIGHTDATA_PROXY=

# Official APIs (optional — used instead of scraping for Walmart/eBay)
WALMART_API_KEY=
WALMART_PRIVATE_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Print scraper output to console
SCRAPER_DEBUG=false

# Auto-sync interval in minutes (default 120 = 2 hours)
SYNC_INTERVAL_MINUTES=120
